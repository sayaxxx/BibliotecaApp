@* ============================================================================
   Vista: Account / AccessDenied
   Se muestra cuando un usuario autenticado no tiene el rol necesario
   para acceder a una página (AccessDeniedPath configurada en Program.cs).
   ============================================================================ *@
@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel text-center border-danger">
            <div class="panel-body py-5">
                <div class="empty-icon">🚫</div>
                <h1 class="h3 fw-700 mt-3">Acceso Denegado</h1>
                <p class="text-muted">Tu cuenta no tiene permisos suficientes para ver esta página.</p>
                <p class="small text-muted">
                    Si crees que es un error, contacta con el administrador del sistema.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Volver al inicio</a>
            </div>
        </div>
    </div>
</div>