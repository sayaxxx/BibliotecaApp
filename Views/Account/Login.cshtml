@* ============================================================================
   Vista: Account / Login
   Formulario de inicio de sesión con toques de Alpine.js:
     - Botón de mostrar/ocultar contraseña (x-data en el campo de password).
     - Carga rápida de cuentas demo (comodidad para la demostración).
   Incluye returnUrl para volver a la página protegida que intentaba abrir.
   ============================================================================ *@
@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var error = ViewData["ErrorMessage"] as string ?? "";
}

<div class="az-center-page">
    <div class="auth-card">
        <div class="auth-head">
            <img src="~/media/logo-book.svg" alt="BibliotecaApp" style="width:60px;height:60px;border-radius:16px;" />
            <h1 class="h4 fw-700 mt-3 mb-0 text-white">Iniciar Sesión</h1>
        </div>
        <div class="auth-body">
            <p class="text-muted text-center mb-4">
                @if (!string.IsNullOrEmpty(error))
                {
                    <span class="text-danger fw-semibold">@error</span>
                }
                else
                {
                    <text>Accede a BibliotecaApp con tu cuenta.</text>
                }
            </p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ReturnUrl" value="@returnUrl" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="tu@correo.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="password-wrap" x-data="{ show: false }">
                        <input asp-for="Password" class="form-control" placeholder="••••••••"
                               autocomplete="current-password" :type="show ? 'text' : 'password'" />
                        <button type="button" class="password-toggle" x-on:click="show = !show"
                                :aria-label="show ? 'Ocultar contraseña' : 'Mostrar contraseña'">
                            <span x-text="show ? '🙈' : '👁'"></span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>

            <div class="text-center mt-3">
                <small class="text-muted">Cuentas de demostración:</small>
                <div class="d-flex gap-2 justify-content-center flex-wrap mt-1">
<button type="button" class="btn btn-sm btn-outline-primary"
                            x-on:click="document.getElementById('Email').value='lector@biblioteca.com';document.getElementById('Password').value='Lector123!'"
                            >👨‍🎓 Lector</button>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            x-on:click="document.getElementById('Email').value='bibliotecario@biblioteca.com';document.getElementById('Password').value='Bibliotecario123!'"
                            >🛠️ Bibliotecario</button>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            x-on:click="document.getElementById('Email').value='admin@biblioteca.com';document.getElementById('Password').value='Admin123!'"
                            >👑 Admin</button>
                </div>
            </div>

            <hr class="my-4" />
            <p class="text-center mb-0">
                ¿No tienes cuenta?
                <a asp-action="Register">Regístrate aquí</a>
            </p>

            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <p class="small text-muted text-center mt-3 mb-0">
                    Serás redirigido a la página que intentabas abrir.
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}