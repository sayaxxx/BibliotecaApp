@* ============================================================================
   Vista: Autores / Index
   Muestra el listado de autores (modelo: IEnumerable<AutorIndexViewModel>)
   con un cuadro de búsqueda por nombre y acciones de detalle/edición/borrado.
   ============================================================================ *@
@model IEnumerable<AutorIndexViewModel>

@{
    ViewData["Title"] = "Autores";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">👤</span>Lista de Autores</h1>
        <p class="page-subtitle">Gestiona los autores y sus obras registradas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Nuevo Autor
    </a>
</div>

<div class="panel mb-4">
    <div class="panel-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label for="buscar" class="form-label">Buscar por nombre</label>
                <input id="buscar" type="text" name="buscar" value="@ViewBag.Buscar"
                       placeholder="Ej: Gabriel García Márquez..." class="form-control" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-light">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="panel empty-state">
        <div class="empty-icon">🔎</div>
        <h3 class="h5 fw-600">No se encontraron autores</h3>
        <p>Prueba con otro término de búsqueda.</p>
    </div>
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table table-modern table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Nacionalidad</th>
                        <th>Fecha de Nacimiento</th>
                        <th>Libros</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var autor in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@autor.Nombre</td>
                            <td>@autor.Nacionalidad</td>
                            <td>@(autor.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td><span class="badge badge-soft-primary">@autor.TotalLibros libro(s)</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-primary" title="Ver detalles">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-sm btn-warning" title="Editar">Editar</a>
                                <a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-sm btn-danger" title="Eliminar">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Volver al inicio</a>
</div>