@* ============================================================================
   Vista: Autores / Index
   Listado de autores (IEnumerable<AutorIndexViewModel>) con búsqueda
   INSTANTÁNEA por nombre mediante HTMX: al teclear, htmx solicita al
   controlador la parcial _TablaAutores y sustituye solo la tabla.
   El formulario clásico se conserva como fallback (requiere JS desactivado).
   ============================================================================ *@
@model IEnumerable<AutorIndexViewModel>

@{
    ViewData["Title"] = "Autores";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">👤</span>Lista de Autores</h1>
        <p class="page-subtitle">Gestiona los autores y sus obras registradas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Nuevo Autor
    </a>
</div>

<div class="panel mb-4">
    <div class="panel-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label for="buscar" class="form-label">Buscar por nombre</label>
                <div class="position-relative">
                    <input id="buscar" type="text" name="buscar" value="@ViewBag.Buscar"
                           placeholder="Ej: Gabriel García Márquez..."
                           class="form-control pe-5"
                           hx-get="@Url.Action("Index")"
                           hx-target="#autoresContainer"
                           hx-swap="outerHTML"
                           hx-trigger="input changed delay:400ms"
                           hx-indicator="#buscando" />
                    <span id="buscando" class="htmx-indicator position-absolute top-50 end-0 translate-middle-y me-3">
                        <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                    </span>
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-light">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_TablaAutores", Model)

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Volver al inicio</a>
</div>