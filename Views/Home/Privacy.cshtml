@* ============================================================================
   Vista: Home / Privacy
   Página estática de política de privacidad de la aplicación.
   ============================================================================ *@
@{
    ViewData["Title"] = "Política de Privacidad";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">🔒</span>@ViewData["Title"]</h1>
        <p class="page-subtitle">Cómo manejamos la información en BibliotecaApp</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-body">
                <p>Este sitio gestiona información bibliotecaria de carácter académico: autores, libros y préstamos. Los datos ingresados son utilizados únicamente con fines de gestión del catálogo y seguimiento de préstamos.</p>
                <p>Respecto a la confidencialidad de la información:</p>
                <ul>
                    <li>No compartimos datos personales con terceros.</li>
                    <li>La información solo es accesible por los administradores de la aplicación.</li>
                    <li>El proyecto tiene fines educativos y de demostración de arquitectura en capas.</li>
                </ul>
            </div>
        </div>
    </div>
</div>