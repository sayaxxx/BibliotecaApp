@* ============================================================================
   Vista: Libros / Edit
   Formulario de edición de libro. Incluye el Id como campo oculto.
   ============================================================================ *@
@model Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">✏️</span>Editar Libro</h1>
        <p class="page-subtitle">Modifica los datos del libro seleccionado</p>
    </div>
    <a asp-action="Index" class="btn btn-light">&larr; Volver a la lista</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">Datos del libro</h2>
            </div>
            <div class="panel-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ISBN" class="form-label"></label>
                        <input asp-for="ISBN" class="form-control" />
                        <span asp-validation-for="ISBN" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AnioPublicacion" class="form-label"></label>
                        <input asp-for="AnioPublicacion" class="form-control" />
                        <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AutorId" class="form-label"></label>
                        <select asp-for="AutorId" class="form-select" asp-items="ViewBag.AutorId">
                            <option value="">-- Seleccione un Autor --</option>
                        </select>
                        <span asp-validation-for="AutorId" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}