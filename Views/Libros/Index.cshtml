@* ============================================================================
   Vista: Libros / Index
   Catálogo de libros con filtro por estado (Disponible / Prestado).
   El cambio en el desplegable dispara HTMX: el controlador devuelve la parcial
   _TablaLibros y solo se sustituye la tabla (sin recargar la página).
   El botón "Filtrar" clásico se conserva como fallback sin JavaScript.
   ============================================================================ *@
@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Libros";
    var estado = ViewData["Estado"] as string ?? "";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">📖</span>Lista de Libros</h1>
        <p class="page-subtitle">Consulta el catálogo y el estado de cada libro</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Nuevo Libro
    </a>
</div>

<div class="panel mb-4">
    <div class="panel-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="estadoLibro" class="form-label">Filtrar por estado</label>
                <select id="estadoLibro" name="estado" class="form-select"
                        hx-get="@Url.Action("Index")"
                        hx-target="#librosContainer"
                        hx-swap="outerHTML"
                        hx-trigger="change">
                    <option value="">Todos los libros</option>
                    <option value="disponible" selected="@(estado == "disponible")">Disponibles</option>
                    <option value="prestado" selected="@(estado == "prestado")">Prestados</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-light">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_TablaLibros", Model)

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Volver al inicio</a>
</div>