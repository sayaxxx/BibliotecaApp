@* ============================================================================
   Vista: Prestamos / Devolver (confirmación)
   Confirma el registro de la devolución. La FechaDevolucion se fija a hoy en
   el controlador (el sistema impide registrar devoluciones de días anteriores).
   Solo para Admin y Bibliotecario.
   ============================================================================ *@
@model Prestamo
@{
    ViewData["Title"] = "Registrar Devolución";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">📥</span>Registrar Devolución</h1>
        <p class="page-subtitle">Confirma la recepción del libro. La fecha se registrará hoy.</p>
    </div>
    <a asp-action="Index" class="btn btn-light">&larr; Volver a la lista</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-success d-flex gap-3 align-items-start" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-arrow-return-left flex-shrink-0 mt-1" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1.5 1.5A.5.5 0 0 0 1 2v9a.5.5 0 0 0 .5.5h11.5v-2.5a.5.5 0 0 1 .821-.384l2.813 2.63a.5.5 0 0 1 0 .768l-2.813 2.63A.5.5 0 0 1 13 10.869V13H1.5A1.5 1.5 0 0 1 0 11.5v-2h1.5v1.5a.5.5 0 0 0 .5.5h8.88l-1.3-1.216a.5.5 0 0 1 0-.768L10.88 7.5H7.5a.5.5 0 0 1 0-1h5.5V6H8.38z"/>
            </svg>
            <div>
                Se registrará la devolución con fecha de <strong>hoy</strong>.
                Esta acción no elimina el préstamo, solo lo marca como devuelto.
            </div>
        </div>

        <div class="panel border-success">
            <div class="panel-body">
                <dl class="row detail-card mb-4">
                    <dt class="col-sm-4">Usuario</dt>
                    <dd class="col-sm-8">@Model.NombreUsuario</dd>

                    <dt class="col-sm-4">Libro</dt>
                    <dd class="col-sm-8">@(Model.Libro?.Titulo ?? "Sin libro")</dd>

                    <dt class="col-sm-4">Fecha de Préstamo</dt>
                    <dd class="col-sm-8">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>
                </dl>

                <form asp-action="Devolver">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-fill">Confirmar Devolución</button>
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>