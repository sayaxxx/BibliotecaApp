@* ============================================================================
   Vista: Prestamos / Index
   Listado de préstamos con combobox de filtro por estado:
       - "pendiente" -> préstamos sin devolver (FechaDevolucion NULL)
       - "devuelto"  -> préstamos ya devueltos
   El valor elegido llega por el parámetro GET 'estado' (ViewData["Estado"]) y
   se conserva en el desplegable al recargar la página.
   ============================================================================ *@
@model IEnumerable<Prestamo>

@{
    ViewData["Title"] = "Préstamos";
    var estado = ViewData["Estado"] as string ?? "";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">🔄</span>Lista de Préstamos</h1>
        <p class="page-subtitle">Seguimiento de préstamos y devoluciones</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Nuevo Préstamo
    </a>
</div>

@* Panel de filtro por estado del préstamo (mismo patrón que el de Libros) *@
<div class="panel mb-4">
    <div class="panel-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="estadoPrestamo" class="form-label">Filtrar por estado</label>
                <select id="estadoPrestamo" name="estado" class="form-select">
                    <option value="">Todos los préstamos</option>
                    <option value="pendiente" selected="@(estado == "pendiente")">No devueltos</option>
                    <option value="devuelto" selected="@(estado == "devuelto")">Devueltos</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-light">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="panel empty-state">
        <div class="empty-icon">🔄</div>
        <h3 class="h5 fw-600">No hay préstamos registrados</h3>
        <p>Registra el primer préstamo para comenzar.</p>
    </div>
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table table-modern table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Usuario</th>
                        <th>Libro</th>
                        <th>Fecha de Préstamo</th>
                        <th>Fecha de Devolución</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@i</td>
                            <td class="fw-semibold">@item.NombreUsuario</td>
                            <td>@(item.Libro?.Titulo ?? "Sin libro")</td>
                            <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.FechaDevolucion.HasValue)
                                {
                                    <span class="badge badge-soft-success">@item.FechaDevolucion.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger">No devuelto</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Ver detalles">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">Eliminar</a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Volver al inicio</a>
</div>