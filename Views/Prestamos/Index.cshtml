@* ============================================================================
   Vista: Prestamos / Index
   Listado de préstamos con filtro por estado (No devueltos / Devueltos).
   - El desplegable dispara HTMX: el controlador devuelve la parcial
     _TablaPrestamos y solo se sustituye la tabla.
   - La acción "Devolver" de cada fila es una POST htmx (DevolverAjax) que
     registra la devolución sin recargar y muestra una notificación.
   Se conservan los formularios clásicos como fallback sin JavaScript.
   ============================================================================ *@
@model IEnumerable<Prestamo>

@{
    ViewData["Title"] = "Préstamos";
    var estado = ViewData["Estado"] as string ?? "";
}

<div class="page-header">
    <div>
        <h1><span class="header-icon">🔄</span>Lista de Préstamos</h1>
        <p class="page-subtitle">Seguimiento de préstamos y devoluciones</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-outline-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
            </svg>
            Formulario completo
        </a>
        <a asp-action="Prestar" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-right me-1" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z"/>
            </svg>
            Registrar Préstamo
        </a>
    </div>
</div>

@* Panel de filtro por estado del préstamo (mismo patrón que el de Libros) *@
<div class="panel mb-4">
    <div class="panel-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="estadoPrestamo" class="form-label">Filtrar por estado</label>
                <select id="estadoPrestamo" name="estado" class="form-select"
                        hx-get="@Url.Action("Index")"
                        hx-target="#prestamosContainer"
                        hx-swap="outerHTML"
                        hx-trigger="change">
                    <option value="">Todos los préstamos</option>
                    <option value="pendiente" selected="@(estado == "pendiente")">No devueltos</option>
                    <option value="devuelto" selected="@(estado == "devuelto")">Devueltos</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-light">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_TablaPrestamos", Model)

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Volver al inicio</a>
</div>