@* ============================================================================
   Parcial: Prestamos/_TablaPrestamos
   Fragmento intercambiable por HTMX (filtro por estado + devoluciones rápidas).
   La acción "Devolver" es una POST vía htmx que actualiza la tabla sin
   recargar la página y muestra una notificación (toast del store de Alpine).
   Mantiene el filtro activo mediante hx-include del combobox #estadoPrestamo.
   ============================================================================ *@
@model IEnumerable<Prestamo>

<div id="prestamosContainer">
    @if (!Model.Any())
    {
        <div class="panel empty-state">
            <img src="~/media/empty-books.svg" alt="Sin préstamos" class="empty-icon mb-2" style="width:110px;height:80px;opacity:0.9;" />
            <h3 class="h5 fw-600">No hay préstamos registrados</h3>
            <p>Registra el primer préstamo para comenzar.</p>
            <a asp-action="Prestar" class="btn btn-primary mt-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-right me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z"/></svg>
                Registrar Préstamo
            </a>
        </div>
    }
    else
    {
        <div class="panel">
            <div class="table-responsive">
                <table class="table table-modern table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th>Libro</th>
                            <th>Fecha de Préstamo</th>
                            <th>Fecha de Devolución</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1; }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@i</td>
                                <td class="fw-semibold">@item.NombreUsuario</td>
                                <td>@(item.Libro?.Titulo ?? "Sin libro")</td>
                                <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.FechaDevolucion.HasValue)
                                    {
                                        <span class="badge badge-soft-success">@item.FechaDevolucion.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-danger">No devuelto</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (item.FechaDevolucion == null)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                hx-post="@Url.Action("DevolverAjax", new { id = item.Id })"
                                                hx-target="#prestamosContainer"
                                                hx-swap="outerHTML"
                                                hx-include="#estadoPrestamo"
                                                hx-confirm="¿Registrar la devolución de «@item.NombreUsuario»? Se usará la fecha de hoy."
                                                title="Registrar devolución">
                                            Devolver
                                        </button>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Ver detalles">Detalles</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">Eliminar</a>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>